{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PricingCatalog",
  "type": "object",
  "required": ["version", "effectiveDate", "source"],
  "properties": {
    "version": { "type": "string" },
    "effectiveDate": { "type": "string", "format": "date" },
    "source": { "type": "string" },
    "region": { "type": "string" },
    "currency": { "type": "string", "default": "USD" }
  }
}
